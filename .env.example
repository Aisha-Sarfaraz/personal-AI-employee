DEV_MODE=true
DRY_RUN=true

# Gmail OAuth2 credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here

# Claude AI (for plan generation and LinkedIn posts)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_PLAN_MODEL=claude-haiku-4-5-20251001

# SMTP email send (S4 — set DEV_MODE=false to activate real sends)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com

# === Gold Tier — Odoo ===
ODOO_URL=http://localhost:8069
ODOO_DB=fte_db
ODOO_UID=1
ODOO_PASSWORD=your_odoo_admin_password

# === Gold Tier — Meta / Facebook + Instagram ===
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_USER_ID=your_instagram_business_user_id

# === Gold Tier — Twitter/X ===
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret
TWITTER_USER_ID=your_numeric_twitter_user_id
